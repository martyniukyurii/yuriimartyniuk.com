{
  "buildCommand": "npm run build",
  "installCommand": "npm install --force",
  "headers": [
    {
      "source": "/3D_models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
